  startNodeId: start
  nodes:
  - id: start
    content: 你好，旅行者。
    nextNodeId: intro
    choices: []
  - id: intro
    content: 前方有村庄和森林，你想去哪里？
    nextNodeId: question
    choices: []
  - id: question
    content: 请选择一条路。
    nextNodeId: 
    choices:
    - text: 去村庄
      nextNodeId: village_end
    - text: 去森林
      nextNodeId: forest_end
  - id: village_end
    content: 沿着左边的小路走，就能到村庄。一路平安！
    nextNodeId: 
    choices: []
  - id: forest_end
    content: 沿着右边的小路走，就能到森林。小心野兽！
    nextNodeId: 
    choices: []
